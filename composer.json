{
  "name": "zindagi-trust/ztams",
  "type": "project",
  "description": "Zindagi Trust Attendance Management System",
  "require": {"php": "^8.3", "laravel/framework": "^11.0"},
  "require-dev": {"laravel/pint": "^1.13", "phpunit/phpunit": "^11.0"},
  "autoload": {"psr-4": {"App\\": "app/", "Database\\Factories\\": "database/factories/", "Database\\Seeders\\": "database/seeders/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {"post-autoload-dump": ["@php artisan package:discover --ansi"], "test": ["@php artisan test"]},
  "config": {"optimize-autoloader": true, "sort-packages": true, "preferred-install": "dist",
    "policy": {
      "advisories": {
        "block": false
      }
    }},
  "minimum-stability": "stable",
  "prefer-stable": true
}
